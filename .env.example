# Run python scripts/init_local.py to generate local secrets without overwriting .env.
DATABASE_URL=sqlite+aiosqlite:///./operations.db
OPENSEARCH_URL=http://localhost:19200
OPENSEARCH_REQUIRED=false
POSTGRES_PASSWORD=
API_READ_KEY=
API_WRITE_KEY=

ENVIRONMENT=local
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
MAX_REQUEST_BYTES=65536
REQUESTS_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=32
BODY_TIMEOUT_SECONDS=5
HANDLER_TIMEOUT_SECONDS=30
